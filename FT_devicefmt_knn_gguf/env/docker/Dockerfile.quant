# ① gemma4-quant: 量子化と参照推論の工場（amd64 + CUDA, T4 向け）
#   役割: BF16 参照推論 / llama-imatrix / llama-quantize / llama-perplexity(--kl-divergence) / llama-server
#   提案書 revB §4-2: llama.cpp は v0.6.0 タグで固定（③ arm64 と同一タグ）
ARG CUDA_VERSION=12.8.1
ARG UBUNTU_VERSION=24.04
ARG LLAMA_CPP_TAG=v0.6.0
# T4 = sm_75。ビルド時間短縮のため対象アーキを 1 つに絞る
ARG CUDA_DOCKER_ARCH=75

FROM docker.io/nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS build
ARG LLAMA_CPP_TAG
ARG CUDA_DOCKER_ARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git ca-certificates curl libssl-dev libgomp1 python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 --branch ${LLAMA_CPP_TAG} https://github.com/ggml-org/llama.cpp . \
    && git rev-parse HEAD > /src/LLAMA_CPP_COMMIT
# GGML_NATIVE=OFF + ALL_VARIANTS: CPU 側の実行経路を実行時に自動選択（別 CPU のホストでも動く）
RUN cmake -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DGGML_NATIVE=OFF -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=${CUDA_DOCKER_ARCH} \
      -DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON \
      -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF \
      -DLLAMA_USE_PREBUILT_UI=ON \
      -DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined \
    && cmake --build build --config Release -j"$(nproc)" \
    && mkdir -p /app/lib /app/bin \
    && find build -name "*.so*" -exec cp -P {} /app/lib \; \
    && cp build/bin/llama-* /app/bin/ \
    && cp -r gguf-py /app/gguf-py \
    && cp /src/LLAMA_CPP_COMMIT /app/

FROM docker.io/nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}
ARG LLAMA_CPP_TAG
LABEL org.opencontainers.image.title="gemma4-quant" \
      org.opencontainers.image.description="llama.cpp ${LLAMA_CPP_TAG} CUDA (sm_75) 量子化・参照推論用" \
      llama.cpp.tag="${LLAMA_CPP_TAG}"
RUN apt-get update && apt-get install -y --no-install-recommends \
      libgomp1 curl ca-certificates python3 python3-pip python3-venv jq \
    && rm -rf /var/lib/apt/lists/*
# ggml の動的バックエンド（GGML_BACKEND_DL）は実行ファイルと同じディレクトリから探すので .so を bin/ に同居させる
COPY --from=build /app/bin /app/bin
COPY --from=build /app/lib /app/bin
COPY --from=build /app/gguf-py /app/gguf-py
COPY --from=build /app/LLAMA_CPP_COMMIT /app/LLAMA_CPP_COMMIT
# gguf-dump 等（GGUF のテンソル表から「1トークンあたり読み出し量」を集計するため）
RUN pip install --break-system-packages --no-cache-dir /app/gguf-py numpy
ENV PATH=/app/bin:$PATH \
    LD_LIBRARY_PATH=/app/bin \
    LLAMA_ARG_HOST=0.0.0.0 \
    LLAMA_CPP_TAG=${LLAMA_CPP_TAG}
WORKDIR /work
# 既定は何もしない（compose から llama-server 等を command で与える）
CMD ["sleep", "infinity"]
